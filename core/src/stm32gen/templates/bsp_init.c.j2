#include "bsp_init.h"

/**
  * @brief  初始化全部已配置的外设。
  * @note   顺序不可调换，每一步都有具体理由：
  *
  *         1. ``bsp_rcc_init()`` —— **必须最先**。外设寄存器写操作依赖
  *            总线时钟，时钟没配好时后续所有配置都可能白写。
  *            同时它把 Flash 等待周期设好，保证接下来 HCLK 拉高后取指稳定。
  *         2. ``bsp_afio_init()`` —— 引脚重映射与 SWJ 释放。
  *            **必须在 GPIO_Init 之前**：重映射改的是引脚的复用功能来源，
  *            配好之后再设引脚模式才有意义。放到之后的话，引脚会按旧映射
  *            被配成复用输出，改了来源后那个脚不再是外设的输出脚 ——
  *            现象是"外设没波形/没信号"，极难排查。
  *         3. ``bsp_gpio_init()`` —— 引脚模式。含 USART 的 TX/RX、
  *            EXTI 的输入引脚、TIM 的 PWM 输出引脚。
  *         4. ``bsp_exti_init()`` —— 外部中断线。必须在 GPIO 之后：
  *            引脚要先配成输入模式，否则中断线选好了但引脚状态不确定，
  *            会立刻误触发一次。
  *         5. ``bsp_usart_init()`` —— 此时 TX/RX 引脚已经是复用模式。
  *         6. ``bsp_tim_init()`` —— 时基、输出比较、中断使能。
  *            PWM 输出引脚已在第 3 步配好。
  *         7. ``bsp_adc_init()`` —— ADCCLK 分频、ADC_Init、通道序列、校准。
  *            模拟输入引脚已在第 3 步配成 GPIO_Mode_AIN；ADC 由时钟树
  *            之外的 ADCCLK 驱动，与 TIM 无关，所以排在 TIM 之后即可。
  *         8. ``bsp_nvic_init()`` —— **放最后**。NVIC 通道一开，
  *            中断立刻可以进；此时外设与引脚都已配置完毕，
  *            不会出现"中断进了但外设还没配好"的窗口。
  * @param  None
  * @retval None
  */
void bsp_init(void)
{
    /* (1) 系统时钟与 Flash 等待周期 */
    bsp_rcc_init();

    /* (2) AFIO：引脚重映射与 SWJ 释放（必须早于 GPIO_Init） */
    bsp_afio_init();

    /* (3) GPIO 引脚（含 USART / EXTI / TIM / ADC 的引脚） */
    bsp_gpio_init();

    /* (4) EXTI 外部中断线 */
    bsp_exti_init();

    /* (5) USART 实例（参数、中断使能、使能外设） */
    bsp_usart_init();

    /* (6) TIM 定时器（时基、输出比较、中断使能） */
    bsp_tim_init();

    /* (7) ADC 模数转换（分频、通道序列、看门狗、校准） */
    bsp_adc_init();

    /* (8) NVIC 优先级分组与中断通道 */
    bsp_nvic_init();
}
