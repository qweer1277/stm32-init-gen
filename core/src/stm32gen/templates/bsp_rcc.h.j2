#define BSP_PCLK2_HZ        {{ ctx.rcc.pclk2_hz }}u
/* 定时器时钟不是 PCLK：APB 分频系数 != 1 时定时器时钟是 PCLK 的 2 倍。
   这极易算错 —— PCLK1 = 36MHz 时 TIM2 的时钟是 72MHz，算定时周期差一倍。 */
#define BSP_TIM1_HZ         {{ ctx.rcc.tim1_hz }}u
#define BSP_TIM234_HZ       {{ ctx.rcc.tim234_hz }}u
{% else %}
